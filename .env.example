# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Google Sheets (둘 중 하나만 채우면 됩니다)
# 1) 서비스 계정 JSON 파일 경로
GOOGLE_SERVICE_ACCOUNT_FILE=./service_account.json
# 2) 시트 문서 키 (URL 의 /d/ 와 /edit 사이 문자열)
GSHEET_KEY=

# 저장소 모드: sheets | local  (local 이면 data/ 폴더의 JSON 파일을 씁니다)
STORAGE_MODE=local

# 프롬프트 버전 (v3: 공수를 시간(H)으로 받고, 화면에서 정한 가용 공수 capacity_hours 안에서 우선순위를 담는다)
PROMPT_VERSION=v3
